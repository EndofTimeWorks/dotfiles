#!/usr/bin/env bash
set -euo pipefail

sample() {
  awk '
    /^cpu / {
      idle = $5 + $6
      total = 0
      for (i = 2; i <= NF; ++i) total += $i
      printf "cpu=%d %d\n", idle, total
    }
    /^MemTotal:/ { total_kib = $2 }
    /^MemAvailable:/ { available_kib = $2 }
    END {
      if (total_kib > 0)
        printf "memory=%d %d\n", total_kib - available_kib, total_kib
    }
  ' /proc/stat /proc/meminfo
}

cpu_temperature() {
  local input label value fallback=""
  shopt -s nullglob

  for input in /sys/class/hwmon/hwmon*/temp*_input; do
    [[ -r "$input" ]] || continue
    value="$(<"$input")"
    [[ "$value" =~ ^[0-9]+$ ]] || continue
    (( value > 0 && value < 150000 )) || continue
    [[ -n "$fallback" ]] || fallback="$value"

    label=""
    [[ -r "${input%_input}_label" ]] && label="$(<"${input%_input}_label")"
    case "$label" in
      Tctl|Package\ id\ *|CPU|CPU\ *)
        awk -v milli="$value" 'BEGIN { printf "%.1f", milli / 1000 }'
        return
        ;;
    esac
  done

  if [[ -n "$fallback" ]]; then
    awk -v milli="$fallback" 'BEGIN { printf "%.1f", milli / 1000 }'
  fi
}

details() {
  local host model kernel uptime load temp disk_total disk_used disk_pct
  host="$(hostnamectl --static 2>/dev/null || hostname)"
  model="$(awk -F: '/^model name/ { sub(/^[[:space:]]+/, "", $2); print $2; exit }' /proc/cpuinfo)"
  kernel="$(uname -r)"
  uptime="$(cut -d. -f1 /proc/uptime)"
  load="$(cut -d' ' -f1-3 /proc/loadavg)"
  temp="$(cpu_temperature)"
  read -r disk_total disk_used disk_pct < <(df -Pk / | awk 'NR == 2 { gsub(/%/, "", $5); print $2, $3, $5 }')

  printf 'host=%s\n' "$host"
  printf 'model=%s\n' "$model"
  printf 'kernel=%s\n' "$kernel"
  printf 'uptime=%s\n' "$uptime"
  printf 'load=%s\n' "$load"
  printf 'temperature=%s\n' "$temp"
  printf 'disk=%s %s %s\n' "$disk_used" "$disk_total" "$disk_pct"
}

case "${1:-sample}" in
  sample) sample ;;
  details) details ;;
  *)
    printf 'usage: %s [sample|details]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
